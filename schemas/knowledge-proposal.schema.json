{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentknowledgevault.dev/schemas/v0.1/knowledge-proposal.schema.json",
  "title": "KASANE Knowledge Proposal v0.1",
  "description": "Agent-authored knowledge submitted as a T0 candidate (see #40). Identity of the proposing agent comes from server configuration, never from this payload. Situation conditions (applies_when/counterconditions) are not accepted until conditional retrieval (#42) defines their grammar; state the situation in the body meanwhile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_ref",
    "knowledge_type",
    "title",
    "body",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "knowledge_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048,
      "pattern": "^vault://(global|project|research|private)/"
    },
    "knowledge_type": {
      "enum": [
        "procedure",
        "design",
        "guidance",
        "pitfall",
        "constraint"
      ],
      "description": "procedure: how to do X; design: design approach/rationale; guidance: what to do in a situation; pitfall: what goes wrong and why; constraint: a rule that must hold."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "UTF-8 body; servers additionally enforce a byte bound. Bound starts small and grows only when operation shows it is too tight."
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "handle"
        ],
        "properties": {
          "source_type": {
            "enum": [
              "repository",
              "web",
              "session",
              "document",
              "other"
            ]
          },
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "stale_after": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
