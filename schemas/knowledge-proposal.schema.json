{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentknowledgevault.dev/schemas/v0.1/knowledge-proposal.schema.json",
  "title": "KASANE Knowledge Proposal v0.1",
  "description": "Agent-authored knowledge submitted as a T0 candidate (see #40). Identity of the proposing agent comes from server configuration, never from this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_ref",
    "knowledge_type",
    "title",
    "body",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "knowledge_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048,
      "pattern": "^vault://(global|project|research|private)/"
    },
    "knowledge_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Open vocabulary, e.g. guidance, procedure, design, pitfall."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "description": "UTF-8 body; servers additionally enforce a byte bound."
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "handle"
        ],
        "properties": {
          "source_type": {
            "enum": [
              "repository",
              "web",
              "session",
              "document",
              "other"
            ]
          },
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "applies_when": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 32
        },
        {
          "type": "array",
          "maxItems": 32
        }
      ],
      "description": "Stored now; matched at retrieval once conditional retrieval (#42) lands."
    },
    "counterconditions": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 32
        },
        {
          "type": "array",
          "maxItems": 32
        }
      ],
      "description": "Stored now; matched at retrieval once conditional retrieval (#42) lands."
    },
    "stale_after": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
